{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && npm run build:widget",
        "dev": "vite",
        "build:widget": "vite build -c vite.widget.config.js && WIDGET_ENTRY=screenshot vite build -c vite.widget.config.js"
    },
    "devDependencies": {
        "@heroicons/vue": "^2.2.0",
        "@inertiajs/vue3": "^3.9.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "modern-screenshot": "^4.7.0",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0",
        "vue": "^3.5.44"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
