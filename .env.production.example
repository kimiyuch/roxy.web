# The server's .env for roxy.kimiyu.ch. Copy it there once (see docs/deploy.md), then
# run `php artisan key:generate --force` and fill in MAIL_PASSWORD. deploy.sh never touches it.
APP_NAME=Roxy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://roxy.kimiyu.ch

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Screenshots stay on the server (storage/app/private), in Switzerland
ROXY_DISK=local

# A Hostpoint mailbox, e.g. roxy@kimiyu.ch (SMTP: asmtp.mail.hostpoint.ch, port 465, SSL)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=asmtp.mail.hostpoint.ch
MAIL_PORT=465
MAIL_USERNAME=roxy@kimiyu.ch
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="roxy@kimiyu.ch"
MAIL_FROM_NAME="Roxy"
